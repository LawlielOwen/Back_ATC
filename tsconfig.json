{
  "compilerOptions": {
  "target": "ES2020",
  "module": "CommonJS",
  "lib": ["ES2020"],
  "outDir": "./dist",
  "rootDir": "./",
  "strict": true,
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
  "moduleResolution": "node",
  "ignoreDeprecations": "6.0",
  "resolveJsonModule": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true
},
  "include": [
    "**/*.ts"
,       "Controller/ClienteController.ts", "Controller/PlantillaCotizacion/PlantillaController.js"  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}